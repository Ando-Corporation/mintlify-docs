{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Ando",
  "colors": {
    "primary": "#09090B",
    "light": "#D4D4D8",
    "dark": "#71717A"
  },
  "favicon": "/favicon.ico",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "fonts": {
    "family": "Geist",
    "body": {
      "family": "Geist",
      "weight": 400
    },
    "heading": {
      "family": "Geist",
      "weight": 600
    }
  },
  "background": {
    "color": {
      "light": "#F7F7F6",
      "dark": "#1F1F1F"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "api": {
    "openapi": "openapi.json",
    "url": "full",
    "playground": {
      "display": "interactive"
    },
    "examples": {
      "defaults": "required",
      "languages": [
        "bash",
        "javascript",
        "python"
      ]
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Docs",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting Started",
            "pages": [
              "docs/start-guide",
              "docs/download-ando"
            ]
          },
          {
            "group": "Your Sidebar",
            "pages": [
              "docs/chat",
              "docs/inbox",
              "docs/search",
              "docs/command-k",
              "docs/invite"
            ]
          },
          {
            "group": "Import Data",
            "pages": [
              "docs/importing-from-slack",
              "docs/other-messaging-bridges"
            ]
          },
          {
            "group": "Agents",
            "pages": [
              "docs/managed-agents"
            ]
          },
          {
            "group": "Integrations",
            "pages": [
              "docs/github",
              "docs/linear",
              "docs/notion",
              "docs/granola",
              "docs/hubspot",
              "docs/sentry",
              "docs/everything-else"
            ]
          }
        ]
      },
      {
        "tab": "Developers",
        "icon": "terminal",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "developers/overview",
              "developers/which-key-do-i-use",
              "developers/quickstart"
            ]
          },
          {
            "group": "Bring your own agents",
            "pages": [
              "docs/third-party-agents",
              "docs/local-coding-agent",
              "docs/ando-mcp"
            ]
          },
          {
            "group": "API workflows",
            "pages": [
              "api-reference/overview",
              "api-reference/authorization",
              "api-reference/messaging-quickstart",
              "api-reference/search-quickstart",
              "api-reference/http-api",
              "api-reference/realtime-quickstart",
              "api-reference/webhooks"
            ]
          },
          {
            "group": "Tools",
            "pages": [
              "developers/sdk",
              "developers/cli",
              "api-reference/snippets"
            ]
          },
          {
            "group": "Reference",
            "pages": [
              "api-reference/endpoint-reference",
              {
                "group": "Stable search",
                "tag": "Stable",
                "openapi": "api-reference/openapi.json",
                "pages": [
                  "GET /search/messages",
                  "GET /search/conversations",
                  "GET /search/members",
                  "GET /search/calls"
                ]
              },
              {
                "group": "Stable messaging",
                "tag": "Stable",
                "openapi": "api-reference/openapi.json",
                "pages": [
                  "GET /conversations/{conversationId}/messages",
                  "POST /conversations/{conversationId}/messages",
                  "GET /conversation-messages/{messageId}",
                  "GET /conversation-messages/{messageId}/replies"
                ]
              },
              {
                "group": "Realtime",
                "tag": "Preview",
                "openapi": "api-reference/openapi.json",
                "pages": [
                  "POST /realtime/connections"
                ]
              },
              {
                "group": "Webhook endpoints",
                "tag": "Preview",
                "openapi": "api-reference/openapi.json",
                "pages": [
                  "POST /webhook-endpoints",
                  "GET /webhook-endpoints",
                  "GET /webhook-endpoints/{endpointId}",
                  "PATCH /webhook-endpoints/{endpointId}",
                  "POST /webhook-endpoints/{endpointId}/rotate-secret",
                  "POST /webhook-endpoints/{endpointId}/test"
                ]
              },
              {
                "group": "Webhook deliveries",
                "tag": "Preview",
                "openapi": "api-reference/openapi.json",
                "pages": [
                  "GET /webhook-deliveries",
                  "POST /webhook-deliveries/{deliveryId}/replay"
                ]
              },
              {
                "group": "Generated references",
                "pages": [
                  "docs/ando-mcp-tools",
                  "api-reference/webhook-events"
                ]
              },
              {
                "group": "Nearly stable",
                "tag": "Candidate",
                "openapi": "api-reference/openapi.json",
                "pages": [
                  "GET /search/tasks"
                ]
              },
              {
                "group": "Preview",
                "tag": "Preview",
                "openapi": "api-reference/openapi.json",
                "pages": [
                  "GET /members/{memberId}",
                  "GET /calls/{callId}",
                  "GET /calls/{callId}/transcript",
                  "GET /tasks/{taskId}",
                  "POST /tasks/{taskId}/updates"
                ]
              },
              {
                "group": "Legacy compatibility",
                "tag": "Legacy",
                "openapi": "api-reference/openapi.json",
                "pages": [
                  "GET /search/clipboard",
                  "GET /clipboards/{clipboardId}"
                ]
              }
            ]
          }
        ]
      },
      {
        "tab": "Changelog",
        "icon": "history",
        "groups": [
          {
            "group": "Updates",
            "pages": [
              "changelog",
              "coming-soon"
            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Ando",
          "href": "https://ando.so",
          "icon": "external-link"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:hello@ando.so"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open Ando",
      "href": "https://app.ando.so"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "x": "https://x.com/andocorporation",
      "linkedin": "https://linkedin.com/company/andohq"
    }
  },
  "redirects": [
    {
      "source": "/docs",
      "destination": "/docs/start-guide"
    },
    {
      "source": "/docs/concepts",
      "destination": "/docs/start-guide"
    },
    {
      "source": "/docs/messages",
      "destination": "/docs/chat"
    },
    {
      "source": "/docs/import-data-from-other-apps",
      "destination": "/docs/other-messaging-bridges"
    },
    {
      "source": "/docs/api",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/api-reference",
      "destination": "/api-reference/overview"
    },
    {
      "source": "/developers/which-integration-path-should-i-use",
      "destination": "/developers/overview"
    },
    {
      "source": "/api-reference/openapi.json",
      "destination": "/openapi-public-api-v1-latest.json"
    },
    {
      "source": "/openapi.json",
      "destination": "/openapi-public-api-v1-latest.json"
    }
  ]
}
